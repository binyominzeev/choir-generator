project:
  name: Advanced SATB Demo
  version: "2.0"

melody:
  source: midi
  file: examples/sample.mid

analysis:
  key_detection: true
  chord_inference: true
  phrase_detection: true

arrangement:
  type: SATB

harmony:
  mode: functional
  roman_numerals:
    enabled: true
  chord_preference:
    diatonic: 0.9
    secondary_dominants: 0.2
  cadence_model:
    authentic: strong
    plagal: medium

voices:
  soprano:
    role: melody
    source: original
  alto:
    role: generated
  tenor:
    role: generated
  bass:
    role: generated

ranges:
  soprano: [C4, G5]
  alto: [G3, D5]
  tenor: [C3, G4]
  bass: [E2, C4]

voice_leading:
  forbid:
    parallel_fifths: true
    parallel_octaves: true
    voice_crossing: true
  prefer:
    stepwise_motion: high
    common_tone_retention: high
    small_leaps: medium

rules:
  max_leap:
    value: 7
    weight: 0.7
  stepwise_preference:
    weight: 0.9

voice_assignment:
  soprano:
    priority:
      melody: 1.0
  alto:
    priority:
      chord_tones: 0.8
      passing_tones: 0.2
  tenor:
    priority:
      chord_tones: 0.9
  bass:
    priority:
      root_motion: 1.0

phrases:
  detect: true
  behavior:
    start:
      dynamics: mp
    climax:
      dynamics: f
    end:
      cadence_strength: high
      dynamics: decrescendo

randomization:
  seed: 42
  voice_variation:
    enabled: true
    intensity: 0.1
  rhythm_variation:
    enabled: false

expression:
  dynamics:
    enabled: true
    base: mp
  shaping:
    crescendo_towards_climax: true
    phrase_decay: true

extensions:
  - name: jazz_rules
  - name: baroque_voice_leading
